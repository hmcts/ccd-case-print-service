diff --git a/lib/depth.js b/lib/depth.js
new file mode 100644
index 0000000000000000000000000000000000000000..f90187d6685f1f869099f54914badc69bccaed1e
--- /dev/null
+++ b/lib/depth.js
@@ -0,0 +1,10 @@
+'use strict';
+
+// CVE-2026-93687: bound AST depth independently of input length and options.
+const MAX_DEPTH = 128;
+
+exports.checkDepth = depth => {
+  if (depth > MAX_DEPTH) {
+    throw new SyntaxError(`Pattern nesting depth exceeds maximum (${MAX_DEPTH})`);
+  }
+};
